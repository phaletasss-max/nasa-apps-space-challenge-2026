*.pyo
*.pyd
.venv/
venv/
.env
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.so

# ----- Node / npm -------------------------------------------
node_modules/
.npm/

# ----- Vite / build output ----------------------------------
app/dist/
dist/
*.tsbuildinfo

